import assert from 'node:assert/strict'
import {reduceUnderstanding,projectUnderstanding,understandingRevision} from '../src/lib/ai-native/brand-understanding.ts'
const now='2026-11-28T10:00:00.000Z',source=(text:string)=>({goal:text,taskId:'task',userId:'owner',now,previousTaskId:'task'})
const item=(quote:string,key='audience',extra:any={})=>({key,scope:'brand',kind:'fact',quote,...extra})
let state:any={}
state=reduceUnderstanding(state,{entries:[item('我们的顾客是家庭，不面向儿童。')]},source('我们的顾客是家庭，不面向儿童。'))
assert.equal(projectUnderstanding(state,now).current[0].text,'我们的顾客是家庭，不面向儿童。')
assert.throws(()=>reduceUnderstanding(state,{entries:[item('面向儿童。')]},source('我们的顾客是家庭，不面向儿童。')),/whole_user_statement/)
for(const text of ['谢谢','能做家庭活动吗？','假如我们开分店','可能会推出新品','比如可以搞抽奖'])assert.throws(()=>reduceUnderstanding({}, {entries:[item(text)]},source(text)),/not_a_current_fact/)
const duplicate=reduceUnderstanding(state,{entries:[item('我们的顾客是家庭，不面向儿童。','other-key')]},source('我们的顾客是家庭，不面向儿童。'))
assert.equal(duplicate.entries.length,1)
state=reduceUnderstanding(state,{entries:[item('我们的顾客是上班族。')]},source('我们的顾客是上班族。'))
assert.equal(projectUnderstanding(state,now).current.length,0)
assert.equal(projectUnderstanding(state,now).unresolved.length,1)
state=reduceUnderstanding(state,{entries:[item('更正：我们的顾客是家庭。','audience',{resolve:true})]},source('更正：我们的顾客是家庭。'))
assert.equal(projectUnderstanding(state,now).current.length,1)
assert.equal(projectUnderstanding(state,now).unresolved.length,0)
assert.throws(()=>reduceUnderstanding(state,{entries:[item('我们的顾客是上班族。','different-key')]},source('我们的顾客是上班族。')),/explicit_resolution_required/)
assert.throws(()=>reduceUnderstanding(state,{entries:[item('我们的顾客是家庭。','audience',{resolve:true})]},source('我们的顾客是家庭。')),/explicit_resolution_required/)
state=reduceUnderstanding(state,{forget:[{key:'audience',scope:'brand',quote:'忘记audience这条理解。'}]},source('忘记audience这条理解。'))
assert.equal(projectUnderstanding(state,now).current.length,0)
assert.throws(()=>reduceUnderstanding(state,{entries:[item('我们的顾客是家庭。')]},source('我们的顾客是家庭。')),/explicit_resolution_required/)
state=reduceUnderstanding(state,{entries:[item('恢复：我们的顾客是家庭。','audience',{resolve:true})]},source('恢复：我们的顾客是家庭。'))
state=reduceUnderstanding(state,{entries:[item('12月圣诞活动赠苹果。','campaign',{month:'2026-12'})]},source('12月圣诞活动赠苹果。'))
assert.equal(projectUnderstanding(state,'2027-01-02T00:00:00Z').current.length,1)
assert.throws(()=>reduceUnderstanding({}, {entries:[item('12月圣诞活动赠苹果。','campaign',{month:'2027-05'})]},source('12月圣诞活动赠苹果。')),/month_evidence_required/)
let plans:any=reduceUnderstanding({}, {plans:[{month:'2026-12',content:'新品主线：原材料到成品，资源和日期待确认。',status:'proposed',quote:'请规划12月新品宣传。'}]},source('请规划12月新品宣传。'))
assert.equal(projectUnderstanding(plans,now).plans[0].status,'proposed')
assert.throws(()=>reduceUnderstanding(plans,{plans:[{month:'2026-12',content:plans.plans[0].content,status:'decided',quote:'谢谢'}]},source('谢谢')),/explicit_direction_required/)
plans=reduceUnderstanding(plans,{plans:[{month:'2026-12',content:plans.plans[0].content,status:'decided',quote:'就按这个方向做',acceptPrevious:true}]},source('就按这个方向做'))
assert.equal(plans.plans[0].status,'decided')
plans=reduceUnderstanding(plans,{entries:[item('更正：新品不做试吃。','new-product',{resolve:true})]},source('更正：新品不做试吃。'))
assert.equal(plans.plans[0].status,'needs_recheck')
assert.throws(()=>reduceUnderstanding({}, {plans:[{month:'2027-07',content:'远期',status:'proposed',quote:'请规划'}]},source('请规划')),/rolling_month_out_of_range/)
assert.throws(()=>reduceUnderstanding({}, {plans:[{month:'2026-11',content:'A',status:'proposed',quote:'请规划'},{month:'2027-01',content:'B',status:'proposed',quote:'请规划'}]},source('请规划')),/consecutive_months_required/)
assert.notEqual(understandingRevision(state),understandingRevision({}))
assert.throws(()=>reduceUnderstanding({}, {entries:[item('我们主推牛肉。')]},source('不要保存，我们主推牛肉。')),/save_declined/)
console.log('brand understanding: grounding, negation, noise, duplicate, conflict, correction, forget, expiry, plans and direction tests passed')

assert.throws(()=>reduceUnderstanding({}, {entries:[item('我们开分店。')]},source('假如条件成熟；我们开分店。')),/whole_user_statement/)

assert.throws(()=>reduceUnderstanding(state,{entries:[item('不要更正：我们的顾客是儿童。','audience',{resolve:true})]},source('不要更正：我们的顾客是儿童。')),/explicit_resolution_required/)

let chosen=reduceUnderstanding({}, {plans:[{month:'2026-12',content:'12月确定主推牛肉新品。',status:'decided',quote:'12月确定主推牛肉新品。'}]},source('12月确定主推牛肉新品。'))
chosen=reduceUnderstanding(chosen,{plans:[{month:'2026-12',content:'替代建议：圣诞活动主线',status:'proposed',quote:'给个替代方案'}]},source('给个替代方案'))
assert.equal(chosen.plans[0].content,'12月确定主推牛肉新品。')
assert.equal(chosen.plans[0].status,'decided')
assert.equal(chosen.plans[0].proposal?.content,'替代建议：圣诞活动主线')

const scopedGoal='请保存以下两条完整原话，适用于2026-12。\n新品视觉以绿色和紫色为主要元素，画面为主、文字辅助。'
const scoped=reduceUnderstanding({}, {entries:[item('新品视觉以绿色和紫色为主要元素，画面为主、文字辅助。','visual',{month:'2026-12'})]},source(scopedGoal))
assert.equal(scoped.entries[0].month,'2026-12')
for(const goal of [scopedGoal.replace('适用于','不适用于'),scopedGoal+'2027-01另议。',scopedGoal.replace('适用于','参考')])assert.throws(()=>reduceUnderstanding({}, {entries:[item('新品视觉以绿色和紫色为主要元素，画面为主、文字辅助。','visual',{month:'2026-12'})]},source(goal)),/month_evidence_required/)

const {boundedLibrarySources}=await import('../src/lib/ai-native/library-evidence.ts')
const full=(id:string,n:number)=>({inspirationCreativeId:id,scenes:[{text:'x'.repeat(n)}],sourceRevision:'r1'})
const evidence=[full('cre_one',90000),full('cre_oversized',190000),full('cre_two',70000),full('cre_three',50000)]
const bounded=boundedLibrarySources(evidence,{contentMatchRequestId:'fixture'})
assert.deepEqual(bounded.sources.map(s=>s.inspirationCreativeId),['cre_one','cre_two'])
assert.deepEqual(bounded.sources[0].scenes,evidence[0].scenes)
assert.deepEqual(bounded.sources[1].scenes,evidence[2].scenes)
assert.deepEqual(bounded.gaps.map(g=>g.sourceCreativeId),['cre_oversized','cre_three'])
assert(Buffer.byteLength(JSON.stringify(bounded))<180000)
assert.equal(boundedLibrarySources([full('cre_huge',190000)],{}).sources.length,0)
