import assert from 'node:assert/strict'
import * as feedback from '../src/lib/brand-plan/revisionFeedback.ts'

assert.deepEqual(feedback.REVISION_REASONS,['sku_mismatch','selling_point','transitions','visual_description','voiceover','subtitle','platform_style','material_feasibility','brand_facts','other'])
const legacy={reasons:['sku'],note:'private note'}
assert.deepEqual(feedback.readCreativeFeedback(legacy),{reasons:['sku_mismatch'],note:'private note'})
assert.deepEqual(legacy.reasons,['sku'])
assert.equal(feedback.validateCreativeFeedback({reasons:[...feedback.REVISION_REASONS],note:''})?.reasons.length,10)
assert.throws(()=>feedback.validateCreativeFeedback({reasons:['guessed'],note:''}),/invalid_creative_feedback/)
assert.throws(()=>feedback.validateCreativeFeedback({reasons:['other'],note:'x'.repeat(2001)}),/invalid_creative_feedback/)
const before={title:'A',planning:'plain',platform:'Instagram',date:'2026-11-01',status:'planned_unimplemented'}
const after={title:'A',planning:'plain',platformTargets:['instagram'],status:'idea_pending'}
assert.deepEqual(feedback.creativeChanges(before,after),[])
const base={title:'Original',planning:'Old',materialRequirements:['old'],aiCaption:'Keep',aiTags:['base']}
assert.deepEqual(feedback.creativeCandidateChanges(base,{title:'Original',planning:' Candidate ',materialRequirements:['film']},{...base,planning:'Candidate',materialRequirements:['film']},'2026-11'),[])
assert.deepEqual(feedback.creativeCandidateChanges(base,{planning:'Candidate'},{...base,planning:'Old',aiCaption:''},'2026-11').map(c=>c.field),['planning','aiCaption'])
assert.deepEqual(feedback.creativeCandidateChanges(base,{planning:'Candidate',aiTags:['model']},{...base,planning:'Candidate'},'2026-11',true),[])
assert.deepEqual(feedback.creativeChanges(after,{...after,planning:'wrong SKU, voiceover',skuDecision:{selectedSkuIds:['sku1']}}).map(c=>c.field),['planning','skuDecision'])
const row=(id:string,changes:any,extra:any={})=>({kind:'CREATIVE_ITEM',version:1,input:{creativeId:id,month:'2026-11',actor:{type:'HUMAN'},changes,dimensions:{source:['source1'],sku:['sku1'],platform:['instagram'],contentType:['video']},...extra}})
const rows=[row('direct',[]),row('edited',[{field:'planning'},{field:'planning'}],{feedback:{reasons:['sku','sku_mismatch','material_feasibility'],note:'private note'}}),row('edited',[{field:'aiCaption'}]),row('edited2',[{field:'planning'}]),row('unknown',undefined),row('ai-direct',[{field:'planning'}],{ai:{reviewChanges:[]}}),row('ai-edited',[{field:'planning'}],{ai:{reviewChanges:[{field:'planning'}]}}),row('ai-old',[{field:'planning'}],{ai:{taskId:'legacy'}}),{kind:'CREATIVE_CANDIDATE_FEEDBACK',version:1,input:{...row('discard',[]).input,event:'candidate_discarded',candidateKey:'candidate1',feedback:{reasons:['other'],note:'hidden'}}},row('bot',[],{actor:{type:'AI'}}),{...row('base',[]),version:0}]
const summary=feedback.summarizeCreativeFeedback(rows)
assert.equal(summary.reviewedScripts,8)
assert.equal(summary.directlyAdoptedScripts,2)
assert.equal(summary.editedScripts,4)
assert.equal(summary.discardedCandidates,1)
assert.equal(summary.bySku.sku1.editedScripts,4)
assert.equal(summary.reasons.sku_mismatch,1)
assert.equal(summary.reasons.material_feasibility,1)
assert.equal(summary.fields.planning,5)
assert.equal(summary.fields.voiceover,undefined)
assert.equal(JSON.stringify(summary).includes('private note'),false)
assert.equal(JSON.stringify(summary).includes('hidden'),false)
assert.equal(feedback.summarizeCreativeFeedback([row('alone',[{field:'planning'}])]).reasons.voiceover,undefined)
const many=Array.from({length:100},(_,i)=>row(`idea${i}`,[],{dimensions:{source:[`source${String(i).padStart(3,'0')}`],sku:['__proto__'],platform:[],contentType:[]}}))
const bounded=feedback.summarizeCreativeFeedback(many)
assert.equal(Object.keys(bounded.bySource).length,50)
assert.equal(bounded.bySource.other.reviewedScripts,51)
assert.deepEqual(feedback.summarizeCreativeFeedback([...many].reverse()),bounded)
assert.equal(bounded.bySku.other.reviewedScripts,100)
assert.equal(bounded.byPlatform.other.reviewedScripts,100)
assert.equal(feedback.summarizeCreativeFeedback(Array.from({length:2100},(_,i)=>row(`bounded${i}`,[]))).reviewedScripts,2000)
assert.equal(feedback.summarizeCreativeFeedback([row('alias',[],{dimensions:{platform:['Instagram','ig','instagram']}})]).byPlatform.instagram.reviewedScripts,1)
assert.throws(()=>feedback.parseFeedbackCursor('not-a-cursor'),/invalid_feedback_cursor/)
const cursor=feedback.feedbackCursor({createdAt:new Date('2026-10-16T00:00:00.000Z'),id:'row1'})
assert.equal(feedback.parseFeedbackCursor(cursor)?.id,'row1')
const evidence={sourceShotId:'s1',textChanges:[{field:'spokenText',before:'abcd',after:'wxyz'}],captionMismatchBlocked:true,voiceReceiptChange:{beforeId:'voice1',afterId:'voice2'},musicReceiptChange:{beforeId:'music1',afterId:'music1'}}
const videoRows=[row('video',[{field:'planning'}],{videoFeedback:evidence}),row('video',[{field:'planning'}],{videoFeedback:{...evidence,captionMismatchBlocked:false,voiceReceiptChange:{beforeId:'voice2',afterId:'voice2'}}}),{kind:feedback.CANDIDATE_FEEDBACK_KIND,version:1,input:{...row('video',[]).input,event:'candidate_discarded',candidateKey:'discarded',videoFeedback:evidence}}]
const measured=feedback.summarizeCreativeFeedback(videoRows)
assert.equal(measured.editDistanceByField.spokenText.total,8)
assert.equal(measured.editDistanceByField.spokenText.comparisons,2)
assert.equal(measured.bySourceShot.s1.editedScripts,1)
assert.equal(measured.captionMismatchBlocks,1)
assert.deepEqual(measured.voiceReplacementRate,{numerator:1,denominator:2,rate:0.5})
assert.deepEqual(measured.musicReplacementRate,{numerator:0,denominator:2,rate:0})
assert.deepEqual(feedback.summarizeCreativeFeedback(rows).voiceReplacementRate,{numerator:0,denominator:0,rate:null})
assert.equal(JSON.stringify(measured).includes('voice1'),false)
assert.equal(JSON.stringify(measured).includes('abcd'),false)
for(const invalid of [{...evidence,reason:'guessed'}, {...evidence,textChanges:[...evidence.textChanges,...evidence.textChanges]}, {...evidence,captionMismatchBlocked:'true'}, {...evidence,textChanges:[{field:'spokenText',before:'a'.repeat(513),after:'b'}]}, {...evidence,voiceReceiptChange:{beforeId:'v',afterId:'w',unknown:true}}, {...evidence,sourceShotId:'__proto__'}]){
  assert.equal(feedback.readVideoFeedback(invalid),null)
  assert.equal(feedback.summarizeCreativeFeedback([row('invalid',[],{videoFeedback:invalid})]).voiceReplacementRate.denominator,0)
}
assert(feedback.readVideoFeedback({textChanges:[{field:'spokenText',before:'😀',after:'😃'}]}))
assert.equal(feedback.summarizeCreativeFeedback([row('unicode',[],{videoFeedback:{textChanges:[{field:'spokenText',before:'😀',after:'😃'}]}})]).editDistanceByField.spokenText.total,1)
const voiceOnly=feedback.summarizeCreativeFeedback([row('voice',[],{videoFeedback:{voiceReceiptChange:{beforeId:null,afterId:'first'}}})])
assert.equal(voiceOnly.voiceReplacementRate.denominator,1);assert.equal(voiceOnly.voiceReplacementRate.numerator,0)
const manyShots=feedback.summarizeCreativeFeedback(many.map((r,i)=>({...r,input:{...r.input,videoFeedback:{sourceShotId:`s${String(i).padStart(3,'0')}`,textChanges:[{field:'overlayText',before:'a',after:'b'}]}}})))
assert.equal(Object.keys(manyShots.bySourceShot).length,50);assert.equal(manyShots.bySourceShot.other.editedScripts,51)
const expensive=feedback.summarizeCreativeFeedback(Array.from({length:30},(_,i)=>row(`expensive${i}`,[],{videoFeedback:{textChanges:[{field:'spokenText',before:'a'.repeat(512),after:'b'.repeat(512)}]}})))
assert(expensive.editDistanceByField.spokenText.excludedPairs>0)
assert(expensive.editDistanceByField.spokenText.comparisons*512*512<=feedback.FEEDBACK_DISTANCE_CELLS)
const attempt=(digest:string,status='passed')=>({artifact:{path:'candidate.json',revision:1,digest},adapted:{shots:[{contractVersion:2,sourceShotId:'s1'}]},classification:{candidateDigest:digest,dimensions:[]},review:{status}})
const quality=(attempts:any[])=>({version:1,attempts})
const qrows=[{kind:'CREATIVE_FIDELITY_REVIEW',version:1,input:{taskId:'task1',qualityReview:quality([attempt('failed','failed')])}},{kind:'CREATIVE_FIDELITY_REVIEW',version:2,input:{taskId:'task1',qualityReview:quality([attempt('failed','failed'),attempt('passed')])}},row('adopted',[],{ai:{taskId:'task1',reviewChanges:[],qualityReview:quality([attempt('failed','failed'),attempt('passed')])}}),{kind:'CREATIVE_FIDELITY_REVIEW',version:3,input:{taskId:'pending',qualityReview:quality([{...attempt('pending'),review:undefined}])}},{kind:'CREATIVE_FIDELITY_REVIEW',version:4,input:{taskId:'forged',qualityReview:quality([{...attempt('forged'),classification:{candidateDigest:'other'}}])}}]
const fidelity=feedback.summarizeCreativeFeedback(qrows)
assert.deepEqual(fidelity.fidelityPassRate,{numerator:1,denominator:2,rate:0.5})
assert.equal(fidelity.reviewedScripts,1)
assert.equal(fidelity.bySourceShot.s1.directlyAdoptedScripts,1)
assert.equal(fidelity.bySourceShot.s1.editedScripts,0)
console.log('PASS: ten reasons, legacy read projection, objective diff, review/adoption/edit/discard counts, private notes, bounded stable dimensions and cursor')
