import assert from 'node:assert/strict'
import {mergeCreativeHistory} from '../src/lib/creativeHistory.ts'
const page=(high:number,low:number,nextBeforeVersion:number|null=low)=>({revisions:Array.from({length:high-low+1},(_,i)=>({id:`v${high-i}`,revision:high-i})),nextBeforeVersion})
const old=page(103,4)
const overlap=mergeCreativeHistory(old,page(104,5))
assert.equal(overlap.nextBeforeVersion,4);assert.equal(overlap.revisions.length,101)
const adjacent=mergeCreativeHistory(old,page(203,104))
assert.equal(adjacent.nextBeforeVersion,4);assert.equal(adjacent.revisions.length,200)
let history=mergeCreativeHistory(old,page(205,106))
assert.equal(history.nextBeforeVersion,106);assert.equal(history.historyRanges.length,2)
// A second refresh creates a second gap before either gap has been filled.
history=mergeCreativeHistory(history,page(407,308))
assert.equal(history.nextBeforeVersion,308);assert.equal(history.historyRanges.length,3)
const snapshot=structuredClone(history)
const previous=history
history=mergeCreativeHistory(history,page(307,208),308)
assert.deepEqual(previous,snapshot,'merging never mutates prior rows or ranges, preserving failed read retries')
assert.equal(history.nextBeforeVersion,208)
history=mergeCreativeHistory(history,page(207,108),208)
assert.equal(history.nextBeforeVersion,106)
history=mergeCreativeHistory(history,page(105,6),106)
assert.equal(history.nextBeforeVersion,4)
history=mergeCreativeHistory(history,page(3,1,null),4)
assert.equal(history.nextBeforeVersion,null);assert.equal(history.hasMore,false)
assert.deepEqual(history.revisions.map(r=>r.revision),Array.from({length:407},(_,i)=>407-i))
assert.deepEqual(mergeCreativeHistory(history,page(3,1,null),4),history,'replayed page is deduplicated')
assert.equal(mergeCreativeHistory(history,page(408,309)).nextBeforeVersion,null,'fully read old history remains complete when connected')
assert.equal(mergeCreativeHistory(history,page(600,501)).nextBeforeVersion,501,'a complete old tail cannot hide a new gap')
assert.equal(mergeCreativeHistory(page(2,0),{revisions:[],nextBeforeVersion:null},0).nextBeforeVersion,null,'empty terminal page closes only its known range')
console.log('PASS: overlap, adjacency, multiple gaps, immutable retries, complete tails and stable version deduplication')
