# Copy this file to .env.test and fill in real values
# These are used by scripts/test-api.mts to run the integration test suite

# Base URL of the AMC Kanban deployment to test
AMC_BASE_URL=https://amc-kanban.immedi.ai

# An AI_AGENT account's API key (get from /profile page after login)
TEST_AGENT_API_KEY=your_agent_api_key_here

# A valid brand ID that the test agent is linked to (or can create under)
# Leave empty to auto-create a test brand during the run
TEST_BRAND_ID=
